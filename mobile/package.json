{
  "name": "carry-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "vite build",
    "build:demo": "vite build --mode emulator",
    "sync": "npm run build && cap sync",
    "android": "npm run sync && cap run android",
    "ios": "npm run sync && cap run ios",
    "emulator:android": "npm run build:demo && cap sync android && cap run android",
    "emulator:ios": "npm run build:demo && cap sync ios && cap run ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "preview": "vite preview --host 127.0.0.1 --port 5179 --strictPort",
    "test": "node --test --experimental-test-isolation=none test/*.test.js",
    "test:browser": "node test/browser.mjs"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/preferences": "8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "vite": "6.4.5"
  }
}
